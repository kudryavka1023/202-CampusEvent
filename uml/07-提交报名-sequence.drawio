mxGeometry x="65" y="928" width="2" height="2" as="geometry"/></mxCell><mxCell id="ftb2" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="525" y="928" width="2" height="2" as="geometry"/></mxCell><mxCell id="ftl2" value="" style="html=1;endArrow=none;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="fta2" target="ftb2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fl2" value="&lt;b&gt;alt&lt;/b&gt;&amp;nbsp;&amp;nbsp;[policyType = DIRECT]" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="72" y="906" width="1836" height="22" as="geometry"/></mxCell><mxCell id="fda2_0" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="65" y="1077" width="2" height="2" as="geometry"/></mxCell><mxCell id="fdb2_0" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1913" y="1077" width="2" height="2" as="geometry"/></mxCell><mxCell id="fdl2_0" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="fda2_0" target="fdb2_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fdt2_0" value="&lt;b&gt;else&lt;/b&gt;&amp;nbsp;&amp;nbsp;[policyType = APPROVAL]" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="72" y="1080" width="1836" height="20" as="geometry"/></mxCell><mxCell id="fta3" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="65" y="1572" width="2" height="2" as="geometry"/></mxCell><mxCell id="ftb3" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="525" y="1572" width="2" height="2" as="geometry"/></mxCell><mxCell id="ftl3" value="" style="html=1;endArrow=none;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="fta3" target="ftb3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fl3" value="&lt;b&gt;opt&lt;/b&gt;&amp;nbsp;&amp;nbsp;[观察者抛异常]" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="72" y="1550" width="1836" height="22" as="geometry"/></mxCell><mxCell id="note0" value="开启写事务（BEGIN IMMEDIATE）：校验与写入原子提交，防并发超卖" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="268" width="550" height="34" as="geometry"/></mxCell><mxCell id="note1" value="UC4-A1/A2：findById 为空或 isOpen=false 时提前返回 failure(NOT_FOUND / ACTIVITY_CLOSED)，图中从略" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="550" height="34" as="geometry"/></mxCell><mxCell id="note2" value="写事务提交（COMMIT）；之后才发布事件，通知失败不回滚报名" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="1332" width="550" height="34" as="geometry"/></mxCell><mxCell id="note3" value="实现类 SimpleRegistrationEventPublisher 对每个观察者 try/catch；失败写 logs/notification-failure.log，报名保持有效，继续调用其他观察者" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1390" y="1616" width="550" height="54" as="geometry"/></mxCell><mxCell id="legend0" value="&lt;b&gt;分支说明&lt;/b&gt;　UC4-A1 活动不存在或已删除（NOT_FOUND）；UC4-A2 活动已开始（ACTIVITY_CLOSED），二者在 isOpen 处提前返回，图中以注释说明；UC4-A3 已有有效报名（DUPLICATE_ACTIVE）；UC4-A4 名额已满（SEATS_FULL）。&lt;br&gt;&lt;b&gt;设计要点&lt;/b&gt;　公共规则全部在 RegistrationService；策略只回答“提交后是 APPROVED 还是 PENDING”。新增抽签/候补时只新增策略实现，不改本流程。EP 是 RegistrationEventPublisher 接口；运行时由 SimpleRegistrationEventPublisher 实现观察者遍历与失败日志。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="60" y="1860" width="1860" height="72" as="geometry"/></mxCell></root></mxGraphModel>