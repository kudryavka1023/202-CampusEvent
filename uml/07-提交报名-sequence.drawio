="geometry"/></mxCell><mxCell id="fl4" value="&lt;b&gt;opt&lt;/b&gt;&amp;nbsp;&amp;nbsp;[邮件发送失败]" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="90" y="2050" width="2550" height="22" as="geometry"/></mxCell><mxCell id="fta5" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="2250" width="2" height="2" as="geometry"/></mxCell><mxCell id="ftb5" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="543" y="2250" width="2" height="2" as="geometry"/></mxCell><mxCell id="ftl5" value="" style="html=1;endArrow=none;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="fta5" target="ftb5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fl5" value="&lt;b&gt;opt&lt;/b&gt;&amp;nbsp;&amp;nbsp;[任一观察者抛异常]" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="90" y="2228" width="2550" height="22" as="geometry"/></mxCell><mxCell id="note0" value="开启写事务（BEGIN IMMEDIATE）：校验与写入原子提交，防并发超卖" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="268" width="850" height="34" as="geometry"/></mxCell><mxCell id="note1" value="UC4-A1/A2：findById 为空或 isOpen=false 时提前返回 failure(NOT_FOUND / ACTIVITY_CLOSED)，图中从略" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="850" height="34" as="geometry"/></mxCell><mxCell id="note2" value="CR-01：年级限定是资格规则；失败时不创建报名、不发通知" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="938" width="700" height="34" as="geometry"/></mxCell><mxCell id="note3" value="写事务提交（COMMIT）；之后才发布事件，通知失败不回滚报名" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="340" y="1616" width="850" height="34" as="geometry"/></mxCell><mxCell id="note4" value="CR-02：EO 只处理 SUBMITTED+APPROVED、APPROVED、REJECTED；PENDING 提交与取消跳过" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="2140" y="1866" width="400" height="34" as="geometry"/></mxCell><mxCell id="note5" value="MockEmailSender 先写 FAILED 再抛异常；发布者捕获后写 logs/notification-failure.log，报名保持有效" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1690" y="2150" width="1000" height="48" as="geometry"/></mxCell><mxCell id="note6" value="SimpleRegistrationEventPublisher 对每个观察者 try/catch；失败写日志，继续调用其他观察者" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1690" y="2294" width="1000" height="48" as="geometry"/></mxCell><mxCell id="legend0" value="&lt;b&gt;分支说明&lt;/b&gt;　UC4-A1 活动不存在或已删除（NOT_FOUND）；UC4-A2 活动已开始（ACTIVITY_CLOSED）；UC4-A3 已有有效报名（DUPLICATE_ACTIVE）；UC4-A4 名额已满（SEATS_FULL）；CR-01 新增年级不符（GRADE_NOT_ALLOWED，提示允许年级与当前年级）。&lt;br&gt;&lt;b&gt;设计要点&lt;/b&gt;　公共规则与资格规则全部在 RegistrationService；策略只回答“提交后是 APPROVED 还是 PENDING”。CR-01 的年级规则由 CompositeEligibilityRule 组合执行，不新增 PolicyType。&lt;br&gt;&lt;b&gt;通知&lt;/b&gt;　站内消息与模拟邮件是两个并列观察者；按 eventKey = registrationId:eventType 幂等；邮件只覆盖直接通过、审核通过、审核拒绝；失败只记日志，不回滚报名。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="60" y="2548" width="2610" height="78" as="geometry"/></mxCell></root></mxGraphModel>