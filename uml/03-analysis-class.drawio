style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1" source="e_student" target="e_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_stu_msg_l0" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=10;" vertex="1" connectable="0" parent="a_stu_msg"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_stu_msg_l1" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=10;" vertex="1" connectable="0" parent="a_stu_msg"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_act_msg" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1" source="e_activity" target="e_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_act_msg_l0" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=10;" vertex="1" connectable="0" parent="a_act_msg"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_act_msg_l1" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=10;" vertex="1" connectable="0" parent="a_act_msg"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="n_scope" value="&lt;b&gt;分析阶段边界&lt;/b&gt;&lt;br&gt;本图只回答“完成用例需要哪些职责与概念”。&lt;br&gt;RegistrationService、RegistrationPolicy、NotificationObserver、DAO&lt;br&gt;都是设计决策，不出现在分析模型中。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="420" height="100" as="geometry"/></mxCell><mxCell id="n_policy" value="&lt;b&gt;报名方式差异的处理&lt;/b&gt;&lt;br&gt;分析模型中由报名控制器承担两条备选职责；&lt;br&gt;设计阶段再抽象为报名策略，避免在分析阶段固化实现。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="900" width="420" height="100" as="geometry"/></mxCell><mxCell id="n_multi" value="&lt;b&gt;实体关联多重性&lt;/b&gt;&lt;br&gt;Student 1—0..* Registration；Activity 1—0..* Registration；&lt;br&gt;Student 1—0..* Message；Activity 1—0..* Message。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="900" width="520" height="100" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;蓝色 = 边界类；绿色 = 控制类；橙色 = 实体类&lt;br&gt;虚线箭头 = 依赖；实线 = 实体关联（带多重性）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="420" height="70" as="geometry"/></mxCell></root></mxGraphModel>