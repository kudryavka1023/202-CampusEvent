<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;CampusEvent · 分析类图（ECB：Boundary–Control–Entity）&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="300" y="12" width="900" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="需求分析阶段口径：只用业务词汇表达职责，不出现 Service、Policy、Observer、DAO、数据库、框架" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="1000" height="20" as="geometry"/></mxCell><mxCell id="pkg_b" value="边界类 «boundary»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="320" height="800" as="geometry"/></mxCell><mxCell id="pkg_c" value="控制类 «control»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="360" height="800" as="geometry"/></mxCell><mxCell id="pkg_e" value="实体类 «entity»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="620" height="800" as="geometry"/></mxCell><mxCell id="b_act" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;text-align:center;padding:4px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«boundary»&lt;/i&gt;&lt;br&gt;&lt;b&gt;活动管理页面&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:5px;vertical-align:top;background:#ffffff;&quot;&gt;接收活动表单输入&lt;br&gt;展示活动列表与操作结果&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="b_browse" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;text-align:center;padding:4px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«boundary»&lt;/i&gt;&lt;br&gt;&lt;b&gt;活动浏览页面&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:5px;vertical-align:top;background:#ffffff;&quot;&gt;展示活动列表与筛选条件&lt;br&gt;接收学生选择的活动&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="260" height="90" as="geometry"/></mxCell><mxCell id="b_reg" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;text-align:center;padding:4px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«boundary»&lt;/i&gt;&lt;br&gt;&lt;b&gt;报名页面&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:5px;vertical-align:top;background:#ffffff;&quot;&gt;展示活动详情与报名按钮&lt;br&gt;展示报名结果与状态&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="260" height="90" as="geometry"/></mxCell><mxCell id="b_approve" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;text-align:center;padding:4px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«boundary»&lt;/i&gt;&lt;br&gt;&lt;b&gt;审批页面&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:5px;vertical-align:top;background:#ffffff;&quot;&gt;展示待审核报名列表&lt;br&gt;接收批准/拒绝操作&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="260" height="90" as="geometry"/></mxCell><mxCell id="b_stat" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;text-align:center;padding:4px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«boundary»&lt;/i&gt;&lt;br&gt;&lt;b&gt;统计页面&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:5px;vertical-align:top;background:#ffffff;&quot;&gt;接收活动选择&lt;br&gt;展示已通过/待审核/剩余名额&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="620" width="260" height="90" as="geometry"/></mxCell><mxCell id="b_msg" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;text-align:center;padding:4px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«boundary»&lt;/i&gt;&lt;br&gt;&lt;b&gt;通知页面&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:5px;vertical-align:top;background:#ffffff;&quot;&gt;展示当前学生的消息列表&lt;br&gt;接收标记已读操作&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontF