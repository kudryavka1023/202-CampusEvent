<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;CampusEvent · 状态图：报名记录 Registration 的生命周期&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="120" y="12" width="1000" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="状态字段 Registration.status : RegistrationStatus ｜ 只有 PENDING / APPROVED 为“有效报名” ｜ 取消与拒绝保留历史 ｜ 年级不符不创建记录" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="42" width="1080" height="18" as="geometry"/></mxCell><mxCell id="init" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="110" y="255" width="24" height="24" as="geometry"/></mxCell><mxCell id="pending" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;待审核 · 不占名额&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="approved" value="&lt;b&gt;APPROVED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;已通过 · 占用 1 个名额&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="rejected" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;已拒绝 · 终态&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="430" width="230" height="80" as="geometry"/></mxCell><mxCell id="cancelled" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;已取消 · 终态&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=11;fontFamily=Microsoft YaHei;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="230" height="80" as="geometry"/></mxCell><mxCell id="t_init_pending" value="提交报名 [policyType = APPROVAL]&lt;br&gt;/ 创建记录(status = PENDING)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="init" target="pending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_init_approved" value="提交报名 [policyType = DIRECT]&lt;br&gt;/ 创建记录(status = APPROVED)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="init" target="approved"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="267"/><mxPoint x="835" y="267"/></Array></mxGeometry></mxCell><mxCell id="t_pending_approved" value="[批准 且 名额充足]&lt;br&gt;/ approve()；publish(APPROVED)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pending" target="approved"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_pending_rejected" value="[管理员拒绝]&lt;br&gt;/ reject()；服务将 reason 写入事件；publish(REJECTED)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pending" target="rejected"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_pending_cancelled" value="[学生取消]&lt;br&gt;/ cancel()；publish(CANCELLED)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=1;exitY=0.85;entryX=0;entryY=0.15;" edge="1" parent="1" source="pending" target="cancelled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="178"/><mxPoint x="640" y="442"/></Array></mxGeometry></mxCell><mxCell id="t_approved_cancelled" value="[学生取消]&lt;br&gt;/ cancel()；释放名额；publish(CANCELLED)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="approved" target="cancelled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_terminal" value="&lt;b&gt;终态与再次申请&lt;/b&gt;&lt;br&gt;REJECTED / CANCELLED 不再迁出；记录保留用于历史与统计。&lt;br&gt;学生再次申请时创建&lt;b&gt;新记录&lt;/b&gt;（新 registrationId），不把旧记录改回 PENDING。&lt;br&gt;因此同一 (activityId, studentId) 可以有多条历史记录，但最多一条有效记录。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="560" height="92" as="geometry"/></mxCell><mxCell id="n_capacity" value="&lt;b&gt;名额与状态&lt;/b&gt;&lt;br&gt;只有 APPROVED 占用容量；PENDING 不占。&lt;br&gt;批准前必须复查名额：&lt;br&gt;hasCapacity(approvedCount) 为假时保持 PENDING。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="570" width="460" height="92" as="geometry"/></mxCell><mxCell id="n_guard" value="&lt;b&gt;迁移守卫（实体内部）&lt;/b&gt;&lt;br&gt;approve(): 仅 PENDING → APPROVED；&lt;br&gt;reject(): 仅 PENDING → REJECTED；&lt;br&gt;cancel(): 仅 PENDING/APPROVED → CANCELLED。&lt;br&gt;非法迁移抛领域异常，由服务层转为失败结果。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="560" height="96" as="geometry"/></mxCell><mxCell id="n_init" value="&lt;b&gt;初始状态由报名方式决定&lt;/b&gt;&lt;br&gt;DIRECT → APPROVED；APPROVAL → PENDING。&lt;br&gt;两种入口都经过同一组公共规则与资格规则校验；&lt;br&gt;差异由 RegistrationPolicy 承担，不在状态图里复制规则。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="690" width="460" height="96" as="geometry"/></mxCell><mxCell id="n_grade" value="&lt;b&gt;CR-01：年级不符不是状态&lt;/b&gt;&lt;br&gt;资格检查在创建 Registration 之前完成；&lt;br&gt;年级不符返回 GRADE_NOT_ALLOWED，不产生任何状态记录。&lt;br&gt;因此状态图不新增“已拒绝报名”状态。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="80" y="810" width="560" height="96" as="geometry"/></mxCell><mxCell id="n_email" value="&lt;b&gt;CR-02：邮件不改变状态&lt;/b&gt;&lt;br&gt;站内消息与模拟邮件都是事件副作用；&lt;br&gt;邮件成功/失败都不迁移 Registration.status。&lt;br&gt;同一 eventKey 最多一次发送尝试。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="810" width="460" height="96" as="geometry"/></mxCell></root></mxGraphModel>