;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2300" y="1310" width="360" height="80" as="geometry"/></mxCell><mxCell id="r_mock_sender" value="" style="dashed=1;endArrow=block;endFill=0;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="MockEmailSender" target="EmailSender"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_mock_logrepo" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="MockEmailSender" target="EmailLogRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_mock_logrepo_l0" value="写 SENT/FAILED" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=9;" vertex="1" connectable="0" parent="d_mock_logrepo"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="RegistrationEventPublisher" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;text-align:center;padding:3px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-style:italic;&quot;&gt;RegistrationEventPublisher&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;border-bottom:1px solid #333333;background:#ffffff;&quot;&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;background:#ffffff;&quot;&gt;+ subscribe(observer: RegistrationObserver): void&lt;br&gt;+ publish(event: RegistrationEvent): void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="1520" width="360" height="160" as="geometry"/></mxCell><mxCell id="RegistrationObserver" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;text-align:center;padding:3px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-style:italic;&quot;&gt;RegistrationObserver&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;border-bottom:1px solid #333333;background:#ffffff;&quot;&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;background:#ffffff;&quot;&gt;+ onRegistrationEvent(event: RegistrationEvent): void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="1740" width="360" height="120" as="geometry"/></mxCell><mxCell id="SimpleRegistrationEventPublisher" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;text-align:center;padding:3px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;b style=&quot;&quot;&gt;SimpleRegistrationEventPublisher&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;border-bottom:1px solid #333333;background:#ffffff;&quot;&gt;- observers: List&amp;lt;RegistrationObserver&amp;gt;&lt;br&gt;- failureLogger: NotificationFailureLogger&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;background:#ffffff;&quot;&gt;+ subscribe(observer: RegistrationObserver): void&lt;br&gt;+ publish(event: RegistrationEvent): void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1360" y="1520" width="420" height="180" as="geometry"/></mxCell><mxCell id="MessageNotificationObserver" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;text-align:center;padding:3px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;b style=&quot;&quot;&gt;MessageNotificationObserver&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;border-bottom:1px solid #333333;background:#ffffff;&quot;&gt;- messageRepository: MessageRepository&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;background:#ffffff;&quot;&gt;+ onRegistrationEvent(event: RegistrationEvent): void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1360" y="1740" width="420" height="140" as="geometry"/></mxCell><mxCell id="EmailNotificationObserver" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;text-align:center;padding:3px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;b style=&quot;&quot;&gt;EmailNotificationObserver&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;border-bottom:1px solid #333333;background:#ffffff;&quot;&gt;- studentRepository: StudentRepository&lt;br&gt;- emailSender: EmailSender&lt;br&gt;- emailLogRepository: EmailLogRepository&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;background:#ffffff;&quot;&gt;+ onRegistrationEvent(event: RegistrationEvent): void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="2060" width="360" height="150" as="geometry"/></mxCell><mxCell id="NotificationFailureLogger" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;text-align:center;padding:3px;border-bottom:1px solid #333333;vertical-align:middle;&quot;&gt;&lt;b style=&quot;&quot;&gt;NotificationFailureLogger&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;border-bottom:1px solid #333333;background:#ffffff;&quot;&gt;- logPath: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;padding:4px;vertical-align:top;background:#ffffff;&quot;&gt;+ log(event: RegistrationEvent, error: Exception): void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1360" y="1920" width="420" height="110" as="geometry"/></mxCell><mxCell id="r_pub" value="" style="dashed=1;endArrow=block;endFill=0;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="SimpleRegistrationEventPublisher" target="RegistrationEventPublisher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r_obs" value="" style="dashed=1;endArrow=block;endFill=0;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="MessageNotificationObserver" target="RegistrationObserver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r_email_obs" value="" style="dashed=1;endArrow=block;endFill=0;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="EmailNotificationObserver" target="RegistrationObserver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_pub_obs" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="SimpleRegistrationEventPublisher" target="RegistrationObserver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_pub_obs_l0" value="通知观察者" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=9;" vertex="1" connectable="0" parent="a_pub_obs"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="d_pub_logger" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="SimpleRegistrationEventPublisher" target="NotificationFailureLogger"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="1610"/><mxPoint x="1810" y="1975"/></Array></mxGeometry></mxCell><mxCell id="d_pub_logger_l0" value="记录失败" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=9;" vertex="1" connectable="0" parent="d_pub_logger"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="d_email_obs_sender" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="EmailNotificationObserver" target="EmailSender"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1790" y="2135"/><mxPoint x="1790" y="905"/></Array></mxGeometry></mxCell><mxCell id="d_email_obs_sender_l0" value="send(message)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=9;" vertex="1" connectable="0" parent="d_email_obs_sender"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="d_email_obs_logrepo" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="EmailNotificationObserver" target="EmailLogRepository"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1824" y="2180"/><mxPoint x="1824" y="1290"/></Array></mxGeometry></mxCell><mxCell id="d_email_obs_logrepo_l0" value="exists / save" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=9;" vertex="1" connectable="0" parent="d_email_obs_logrepo"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="n_domain_1" value="&lt;b&gt;为什么策略只决定初始状态&lt;/b&gt;&lt;br&gt;公共规则（活动未开始、无重复、年级、名额未满）对两种报名方式相同，&lt;br&gt;放在 RegistrationService；策略只回答“提交后是已通过还是待审核”。&lt;br&gt;新增抽签/候补时扩展策略，不改公共规则。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1820" width="420" height="120" as="geometry"/></mxCell><mxCell id="n_domain_2" value="&lt;b&gt;枚举引用&lt;/b&gt;&lt;br&gt;Activity.policyType → PolicyType；Registration.status → RegistrationStatus；&lt;br&gt;RegistrationEvent.type → RegistrationEventType；review 的 decision → ApprovalDecision。&lt;br&gt;为避免连线穿越实体框，枚举依赖用属性类型表达，不另画虚线。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="1820" width="380" height="120" as="geometry"/></mxCell><mxCell id="n_domain_3" value="&lt;b&gt;观察者实现要点&lt;/b&gt;&lt;br&gt;MessageNotificationObserver 依赖 MessageRepository（见架构类图）；&lt;br&gt;按 eventKey 幂等；SimpleRegistrationEventPublisher 对每个观察者 try/catch，&lt;br&gt;失败交给 NotificationFailureLogger 写 logs/notification-failure.log，不回滚报名。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1960" width="420" height="120" as="geometry"/></mxCell><mxCell id="n_domain_4" value="&lt;b&gt;状态机&lt;/b&gt;&lt;br&gt;Registration 的四个状态与迁移见 09-state.drawio；&lt;br&gt;approve/reject/cancel 内部先校验当前状态，再迁移。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="1960" width="380" height="100" as="geometry"/></mxCell><mxCell id="n_cr01" value="&lt;b&gt;CR-01：为什么是资格规则而不是新策略&lt;/b&gt;&lt;br&gt;策略契约只回答“初始状态是 APPROVED 还是 PENDING”，无法表达“拒绝且不建记录”；&lt;br&gt;年级与名额、时间、重复报名同属“是否允许报名”的公共资格约束。&lt;br&gt;CompositeEligibilityRule 按顺序执行，返回第一个 EligibilityViolation；&lt;br&gt;RegistrationService 在策略之前调用一次，新增规则只需加实现类。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="1460" width="860" height="120" as="geometry"/></mxCell><mxCell id="n_cr02" value="&lt;b&gt;CR-02：为什么新增观察者&lt;/b&gt;&lt;br&gt;EmailNotificationObserver 与站内消息观察者并列订阅同一 RegistrationEvent；&lt;br&gt;只处理 SUBMITTED+APPROVED、APPROVED、REJECTED；按 eventKey 幂等。&lt;br&gt;MockEmailSender 先写 email_log（SENT/FAILED），失败再抛 EmailSendError；&lt;br&gt;发布者捕获后写失败日志，报名已提交，不回滚。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="1600" width="860" height="120" as="geometry"/></mxCell></root></mxGraphModel>