 int): List&amp;lt;EmailLog&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeColor=#333333;fillColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1780" y="800" width="300" height="180" as="geometry"/></mxCell><mxCell id="d_ui_0" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="ActivityController" target="ActivityService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_ui_1" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="RegistrationController" target="RegistrationService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_ui_2" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="ApprovalController" target="RegistrationService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_ui_3" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="NotificationController" target="NotificationQueryService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_ui_4" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="StatisticsController" target="StatisticsService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_ui_5" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="EmailLogController" target="EmailLogQueryService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_0" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="ActivityService" target="ActivityRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_1" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="ActivityService" target="RegistrationRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_2" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="RegistrationService" target="ActivityRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_3" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="RegistrationService" target="RegistrationRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_4" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="NotificationQueryService" target="MessageRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_7" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="RegistrationService" target="StudentRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_8" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="EmailLogQueryService" target="EmailLogRepository"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_svc_5" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="StatisticsService" target="ActivityRepository"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="735"/><mxPoint x="270" y="735"/></Array></mxGeometry></mxCell><mxCell id="d_svc_6" value="" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#666666;strokeWidth=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="StatisticsService" target="RegistrationRepository"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="755"/><mxPoint x="690" y="755"/></Array></mxGeometry></mxCell><mxCell id="n_arch_1" value="&lt;b&gt;依赖倒置&lt;/b&gt;&lt;br&gt;服务只依赖 Repository / TransactionManager 接口；&lt;br&gt;Sqlite*Repository、SqliteTransactionManager&lt;br&gt;在基础设施层实现并在组合根装配。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1080" width="520" height="110" as="geometry"/></mxCell><mxCell id="n_arch_2" value="&lt;b&gt;领域层依赖（详见领域类图）&lt;/b&gt;&lt;br&gt;ActivityService → Activity；RegistrationService → Activity、Registration、Student、&lt;br&gt;RegistrationPolicyFactory、EligibilityRule、RegistrationEventPublisher；&lt;br&gt;NotificationQueryService → Message；EmailLogQueryService → EmailLog；&lt;br&gt;StatisticsService → ActivityStatistics。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="1080" width="620" height="110" as="geometry"/></mxCell><mxCell id="n_arch_3" value="&lt;b&gt;事务边界&lt;/b&gt;&lt;br&gt;RegistrationService.submit/review/cancel 在写事务内完成&lt;br&gt;“检查 + 状态迁移 + 保存”；提交后再 publish 事件。&lt;br&gt;站内消息与模拟邮件都在提交后由观察者处理；&lt;br&gt;邮件失败只记 FAILED + 失败日志，不回滚报名。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="1080" width="460" height="120" as="geometry"/></mxCell><mxCell id="n_arch_4" value="&lt;b&gt;控制器职责&lt;/b&gt;&lt;br&gt;只做参数绑定、角色/会话校验、调用服务、渲染结果；&lt;br&gt;不写业务规则，不直接访问 Repository。&lt;br&gt;ApprovalController.approve/reject 仅绑定决定与理由，统一委托 RegistrationService.review(...)。&lt;br&gt;ActivityController.detail 只读组合 ActivityService、RegistrationService、StatisticsService；&lt;br&gt;图中返回类型简写为 Optional&amp;lt;Activity&amp;gt;，实际模板上下文含活动、当前报名与统计。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1210" width="620" height="140" as="geometry"/></mxCell><mxCell id="n_arch_5" value="&lt;b&gt;类型写法&lt;/b&gt;&lt;br&gt;为图面可读，List/Optional 省略元素类型；&lt;br&gt;完整签名（List&amp;lt;ActivitySummary&amp;gt;、List&amp;lt;RegistrationSummary&amp;gt; 等）&lt;br&gt;见设计说明书 7.3。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="1210" width="520" height="100" as="geometry"/></mxCell><mxCell id="n_arch_6" value="&lt;b&gt;事务管理器&lt;/b&gt;&lt;br&gt;基础设施层实现 TransactionManager 接口；&lt;br&gt;服务构造注入；写事务用 BEGIN IMMEDIATE，&lt;br&gt;提交后再 publish 事件。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="1210" width="460" height="100" as="geometry"/></mxCell><mxCell id="n_arch_7" value="&lt;b&gt;CR-01 / CR-02 的装配&lt;/b&gt;&lt;br&gt;组合根构造 CompositeEligibilityRule([GradeEligibilityRule()]) 注入 RegistrationService；&lt;br&gt;同一发布者订阅 MessageNotificationObserver 与 EmailNotificationObserver；&lt;br&gt;EmailNotificationObserver 依赖 EmailSender + EmailLogRepository，&lt;br&gt;运行时分别为 MockEmailSender、SqliteEmailLogRepository。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1370" width="720" height="110" as="geometry"/></mxCell></root></mxGraphModel>