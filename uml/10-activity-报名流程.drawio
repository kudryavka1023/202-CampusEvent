></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;entryX=0;entryY=0.5;" edge="1" parent="1" source="f2" target="merge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="450"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;entryX=0;entryY=0.5;" edge="1" parent="1" source="f_grade" target="merge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="570"/><mxPoint x="920" y="985"/></Array></mxGeometry></mxCell><mxCell id="e22" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;entryX=0;entryY=0.5;" edge="1" parent="1" source="f3" target="merge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="690"/><mxPoint x="940" y="985"/></Array></mxGeometry></mxCell><mxCell id="e23" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="merge" target="end_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="985"/><mxPoint x="1015" y="1230"/></Array></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;失败路径&lt;/b&gt;&lt;br&gt;活动不存在 / 已开始（UC4-A1、UC4-A2）→ NOT_FOUND / ACTIVITY_CLOSED；&lt;br&gt;已有有效报名（UC4-A3）→ DUPLICATE_ACTIVE；&lt;br&gt;年级不符（CR-01）→ GRADE_NOT_ALLOWED，提示允许年级与当前年级；&lt;br&gt;名额已满（UC4-A4）→ SEATS_FULL。失败路径均不创建报名、不发通知。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="80" y="1300" width="620" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;分支与合并&lt;/b&gt;&lt;br&gt;DIRECT 与 APPROVAL 只改变初始状态，之后共用保存、事件、通知、展示；&lt;br&gt;策略类不重复实现名额/重复/活动状态/年级规则。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="740" y="1300" width="560" height="80" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;通知副作用（CR-02）&lt;/b&gt;&lt;br&gt;发布事件后由两个观察者分别写站内消息与模拟邮件；&lt;br&gt;仅直接报名通过、审核通过、审核拒绝发邮件；&lt;br&gt;邮件失败写 FAILED + 失败日志，不回滚报名。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=9;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="740" y="1400" width="560" height="90" as="geometry"/></mxCell></root></mxGraphModel>