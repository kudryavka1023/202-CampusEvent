<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;CampusEvent · 活动图：学生提交报名（UC4）&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="180" y="12" width="680" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="覆盖公共规则、年级资格、报名方式分支与通知副作用；审批型在此结束为 PENDING，后续审批见 07-审批报名-sequence.drawio" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="42" width="800" height="18" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="76" width="20" height="20" as="geometry"/></mxCell><mxCell id="a1" value="学生选择活动并提交报名" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="260" height="50" as="geometry"/></mxCell><mxCell id="a2" value="系统加载活动、学生年级、当前报名与已通过人数" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="320" height="60" as="geometry"/></mxCell><mxCell id="d1" value="活动可报名？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="390" y="290" width="120" height="80" as="geometry"/></mxCell><mxCell id="d2" value="已有有效报名？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="120" height="80" as="geometry"/></mxCell><mxCell id="d_grade" value="年级符合？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="390" y="530" width="120" height="80" as="geometry"/></mxCell><mxCell id="d3" value="名额已满？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="390" y="650" width="120" height="80" as="geometry"/></mxCell><mxCell id="d4" value="报名方式？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="390" y="770" width="120" height="80" as="geometry"/></mxCell><mxCell id="f1" value="提示：活动不存在或已开始" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="305" width="240" height="50" as="geometry"/></mxCell><mxCell id="f2" value="提示：请勿重复报名" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="425" width="240" height="50" as="geometry"/></mxCell><mxCell id="f_grade" value="提示：年级不符&lt;br&gt;（写出允许年级）" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="545" width="240" height="50" as="geometry"/></mxCell><mxCell id="f3" value="提示：名额已满" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="665" width="240" height="50" as="geometry"/></mxCell><mxCell id="a3" value="创建 APPROVED 报名" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="100" y="880" width="220" height="50" as="geometry"/></mxCell><mxCell id="a4" value="创建 PENDING 报名" style="rounded=1;arcSize=30;whiteSpace=wr