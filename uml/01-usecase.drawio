<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;CampusEvent 校园活动报名与管理系统 · 用例图&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="320" y="15" width="760" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="初始版本 P2-F01～P2-F08 ｜ 参与者：学生、管理员 ｜ 固定演示账号，不实现注册/登录" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="45" width="760" height="20" as="geometry"/></mxCell><mxCell id="boundary" value="CampusEvent 校园活动报名与管理系统" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="760" height="700" as="geometry"/></mxCell><mxCell id="student" value="学生" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="300" width="50" height="90" as="geometry"/></mxCell><mxCell id="admin" value="管理员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="50" height="90" as="geometry"/></mxCell><mxCell id="uc1" value="创建活动" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc2" value="编辑/删除活动" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc3" value="浏览/筛选活动" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc3a" value="查看活动详情" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc4" value="提交报名" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="380" y="430" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc5" value="取消报名" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc6" value="审批报名" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc7" value="查看报名统计" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="220" height="70" as="geometry"/></mxCell><mxCell id="uc8" value="查看站内通知" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="380" y="660" width="220" height="70" as="geometry"/></mxCell><mxCell id="a_s_uc3" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="student" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_s_uc4" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="student" target="uc4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_s_uc5" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="student" target="uc5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_s_uc8" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="student" target="uc8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_a_uc1" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="admin" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_a_uc2" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="admin" target="uc2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_a_uc6" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="admin" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_a_uc7" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="admin" target="uc7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_extend" value="«extend»&lt;br&gt;[学生选择某一活动]" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#333333;strokeWidth=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="uc3a" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_uc4" value="&lt;b&gt;UC4 的两条备选流&lt;/b&gt;&lt;br&gt;直接报名 → 已通过；审核型 → 待审核。&lt;br&gt;两条路径触发器与目标相同，不拆成两个用例；&lt;br&gt;设计阶段用策略承载差异，公共规则留在报名业务协调处。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="420" height="120" as="geometry"/></mxCell><mxCell id="n_uc2" value="&lt;b&gt;删除策略（本设计选择）&lt;/b&gt;&lt;br&gt;有报名记录 → 拒绝删除并提示；&lt;br&gt;不做软删除，避免所有查询都要过滤 deleted。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="420" height="90" as="geometry"/></mxCell><mxCell id="n_uc6" value="&lt;b&gt;审批边界&lt;/b&gt;&lt;br&gt;批准时复查名额；拒绝不需复查。&lt;br&gt;名额已满时批准失败，报名保持待审核。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="900" width="420" height="70" as="geometry"/></mxCell><mxCell id="n_scope" value="&lt;b&gt;范围说明&lt;/b&gt;&lt;br&gt;不含注册/登录、邮件/短信、候补/抽签、&lt;br&gt;活动取消/归档、跨活动报表。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="800" width="300" height="120" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;小人 = 参与者&lt;br&gt;椭圆 = 用例&lt;br&gt;实线 = 参与者与用例的关联&lt;br&gt;虚线箭头 = «extend»（条件增强）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="250" height="120" as="geometry"/></mxCell></root></mxGraphModel>